{
  "info": {
    "name": "Baozi Store - UNINTER",
    "description": "Execute 01, 02, 03, os GETs e finalmente DELETEs. Collection variables salvam os IDs automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Criar cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function() { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"clienteId\", String(body.id));",
              "pm.test(\"ID gerado\", function() { pm.expect(body.id).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Renan5026727\",\n  \"clienteDesde\": \"2026-11-19\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
